LAMMPS (29 Oct 2020)
# Configuration files
variable cfgFile         string "initial.data"
# Timesteps
variable numSteps        equal  10000
variable dt              equal  0.0005
# NN
variable nnpCutoff       equal  6.35013
variable nnpDir          string "/data/home/salvatorer26/projects/ferrite_oxide/production/production_committee/"
# Masses
variable mass_H          equal  1.00784                                               # mass for
variable mass_O          equal  15.9990                                               # mass for
variable mass_Fe         equal  55.845                                             # mass for

# For Equilibration
variable temperature_i      equal  300
variable temperature_f      equal  300
variable pressure         equal  1.01325
###############################################################################
# GENERAL SETUP
###############################################################################
units metal
boundary p p p
atom_style atomic
read_data ${cfgFile}
read_data initial.data
Reading data file ...
  orthogonal box = (0.0000000 0.0000000 0.0000000) to (33.584000 33.584000 71.478380)
  2 by 2 by 3 MPI processor grid
  reading atoms ...
  8224 atoms
  read_data CPU = 0.009 seconds
##replicate 4 4 1
mass 1 ${mass_H}
mass 1 1.00784
mass 2 ${mass_O}
mass 2 15.999
mass 3 ${mass_Fe}
mass 3 55.845
timestep ${dt}
timestep 0.0005

region bulk block INF INF INF INF  32 37 side in #define the region where thermostat will be applied: low(1-4uc) 13.2 18.2;   middle(5-8uc)  15. 20.; full  32. 37.
group bulk_atoms region bulk # finds which atoms are in that region
480 atoms in group bulk_atoms

###############################################################################
# NN               ew=extrapolation warnings   cd=commitee disagrmeement  de= disag. energy df= disag forces
###############################################################################

pair_style nnp dir ${nnpDir} showew no showewsum 100 resetew yes maxew 1000000 calcd 50 wricde 10000000 maxcde 1000 wricdf 2 maxcdf 100 cflength 1.0 cfenergy 1.0 emap "1:H, 2:O, 3:Fe"
pair_style nnp dir /data/home/salvatorer26/projects/ferrite_oxide/production/production_committee/ showew no showewsum 100 resetew yes maxew 1000000 calcd 50 wricde 10000000 maxcde 1000 wricdf 2 maxcdf 100 cflength 1.0 cfenergy 1.0 emap "1:H, 2:O, 3:Fe"

pair_coeff * * ${nnpCutoff}
pair_coeff * * 6.35013

###############################################################################
# Equilibration
###############################################################################
# Integrator
thermo 50
thermo_style custom time temp pe ke etotal density atoms press pxx pyy pzz step

#fix lange all langevin ${temperature_i} ${temperature_f} 0.1 12282 tally yes
velocity all create 300 12345


#fix 3 bulk_atoms langevin ${temperature_i} ${temperature_f} 0.05 12282 tally yes
#fix 1 all nve #temp ${temperature_i} ${temperature_f} $(100.0*dt) iso 0. 0. $(1000.0*dt)
fix 1 all npt temp ${temperature_i} ${temperature_f} $(100.0*dt) z ${pressure} ${pressure} $(1000.0*dt)
fix 1 all npt temp 300 ${temperature_f} $(100.0*dt) z ${pressure} ${pressure} $(1000.0*dt)
fix 1 all npt temp 300 300 $(100.0*dt) z ${pressure} ${pressure} $(1000.0*dt)
fix 1 all npt temp 300 300 0.050000000000000002776 z ${pressure} ${pressure} $(1000.0*dt)
fix 1 all npt temp 300 300 0.050000000000000002776 z 1.01325 ${pressure} $(1000.0*dt)
fix 1 all npt temp 300 300 0.050000000000000002776 z 1.01325 1.01325 $(1000.0*dt)
fix 1 all npt temp 300 300 0.050000000000000002776 z 1.01325 1.01325 0.5
fix 2 all recenter INIT INIT INIT

dump equi all custom 50 trjmagnetite.dump id type x y z xu yu zu
dump_modify equi sort id


#restart 1000 restart.*.equil
run ${numSteps}
run 10000

