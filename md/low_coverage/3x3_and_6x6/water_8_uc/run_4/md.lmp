# Configuration files
variable cfgFile         string "continue.data"
# Timesteps
variable numSteps     	 equal  2000000000
variable dt              equal  0.0005
# NN
variable nnpCutoff       equal  6.35013
variable nnpDir          string "/gpfs/data/fs71576/salvatore/ferrite_oxide/production/production_committee/"
# Masses
variable mass_H          equal  1.00784                                               # mass for
variable mass_O          equal  15.9990                                               # mass for
variable mass_Fe         equal  55.845                                             # mass for

# For Equilibration
variable temperature_i      equal  300
variable temperature_f      equal  300
variable pressure         equal  1.01325
###############################################################################
# GENERAL SETUP
###############################################################################
units metal
boundary p p p
atom_style atomic
#read_data ${cfgFile}
read_restart ${cfgFile}
##replicate 4 4 1
mass 1 ${mass_H}
mass 2 ${mass_O}
mass 3 ${mass_Fe}
timestep ${dt}

region bulk block INF INF INF INF  15. 20. side in #define the region where thermostat will be applied: low(1-4uc) 13.2 18.2;   middle(5-8uc)  15. 20.; full  32. 37. 
group bulk_atoms region bulk # finds which atoms are in that region

###############################################################################
# NN               ew=extrapolation warnings   cd=commitee disagrmeement  de= disag. energy df= disag forces
###############################################################################

pair_style nnp dir ${nnpDir} showew no showewsum 1000 resetew yes maxew 1000000 calcd 1000 wricde 10000000 maxcde 1000 wricdf 2 maxcdf 50 cflength 1.0 cfenergy 1.0 emap "1:H, 2:O, 3:Fe"

pair_coeff * * ${nnpCutoff}

###############################################################################
# Equilibration
###############################################################################
# Integrator
thermo 1000
thermo_style custom time temp pe ke etotal density atoms press pxx pyy pzz step

#fix lange all langevin ${temperature_i} ${temperature_f} 0.1 12282 tally yes
#velocity all create 300 12345


fix 3 bulk_atoms langevin ${temperature_i} ${temperature_f} 0.05 12282 tally yes
fix 1 all nve #temp ${temperature_i} ${temperature_f} $(100.0*dt) iso 0. 0. $(1000.0*dt)

fix 2 all recenter INIT INIT INIT

dump equi all custom 1000 trjmagnetite.dump id type x y z xu yu
dump_modify equi sort id


restart 5000 restart_a_tmp restart_b_tmp
run ${numSteps}
write_data out.data

